{"schemaVersion":1,"projectId":"construct","projectTitle":"Construct","repository":"Construct","entries":[{"id":"construct--repository--readme-md--6ef3428e83#adding-new-structures","documentId":"construct--repository--readme-md--6ef3428e83","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Adding New Structures","originalTitle":"Adding New Structures","route":"/docs/construct/repository-readme#adding-new-structures","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/README.md","sourceType":"repository","documentTitle":"Construct","sectionTitle":"Adding New Structures","headingPath":["Usage","Adding New Structures"],"snippet":"Adding New Structures Construct uses Minecraft's vanilla structure system so that you can easily create and build new structures. - The simplest way to add a new structure to the structure list is to save it using a structure block or the /structure command. This will only save the structure to the world you're in. - Importin…","syntax":"","aliases":["Construct","Usage"]},{"id":"construct--repository--docs-api-md--e4759d013d#api-reference","documentId":"construct--repository--docs-api-md--e4759d013d","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"API Reference","originalTitle":"API Reference","route":"/docs/construct/docs-api#api-reference","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/API.md","sourceType":"repository","documentTitle":"API Reference","sectionTitle":"API Reference","headingPath":["API Reference"],"snippet":"API Reference This section documents the public API of Construct, including all endpoints that can be accessed by other addons or scripts. This is intended for advanced users who want to extend or integrate with Construct beyond the provided CLI commands and GUI features.","syntax":"","aliases":[]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#cli-reference","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"CLI Reference","originalTitle":"CLI Reference","route":"/docs/construct/docs-cli#cli-reference","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"CLI Reference","headingPath":["CLI Reference"],"snippet":"CLI Reference All commands are prefixed with construct: . Arguments in angle brackets ( ) are required, while those in square brackets ( [arg] ) are optional. Assume commands can be run from any source (player, entity, block, or server) unless otherwise noted.","syntax":"","aliases":[]},{"id":"construct--repository--readme-md--6ef3428e83#commands","documentId":"construct--repository--readme-md--6ef3428e83","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Construct Gives You The — Commands","originalTitle":"Commands","route":"/docs/construct/repository-readme#commands","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/README.md","sourceType":"repository","documentTitle":"Construct","sectionTitle":"Commands","headingPath":["Usage","Commands"],"snippet":"Commands Usage: /construct:construct Gives you the Construct item. Use it to open the Construct menu.","syntax":"","aliases":["Commands","Construct","Usage"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-create","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Create","originalTitle":"construct:create","route":"/docs/construct/docs-cli#construct-create","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:create","headingPath":["CLI Reference","Instance Management","construct:create"],"snippet":"construct:create Create a new instance bound to a structure. Argument Description --- --- Unique name for this instance. ID of a structure saved in the world (without the mystructure: prefix). Corresponds to the \"create new instance\" flow in the main menu. Errors if instanceName is already taken or structureId does not exist.","syntax":"","aliases":["CLI Reference","Instance Management"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-delete","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Delete","originalTitle":"construct:delete","route":"/docs/construct/docs-cli#construct-delete","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:delete","headingPath":["CLI Reference","Instance Management","construct:delete"],"snippet":"construct:delete Permanently delete an instance. Argument Description --- --- Name of the instance to delete. Calls structureCollection.delete() . Also disables the instance and clears its saved dynamic properties before removal.","syntax":"","aliases":["CLI Reference","Instance Management"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-disable","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Disable","originalTitle":"construct:disable","route":"/docs/construct/docs-cli#construct-disable","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:disable","headingPath":["CLI Reference","Enable / Disable","construct:disable"],"snippet":"construct:disable Disable an active instance. Tears down outliner rendering and pauses the verifier. The instance retains its saved location and can be re-enabled.","syntax":"","aliases":["CLI Reference","Enable / Disable"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-enable","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Enable","originalTitle":"construct:enable","route":"/docs/construct/docs-cli#construct-enable","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:enable","headingPath":["CLI Reference","Enable / Disable","construct:enable"],"snippet":"construct:enable Enable a placed instance. Requires the instance to have a saved location. Refreshes the outliner, verifier, and materials cache.","syntax":"","aliases":["CLI Reference","Enable / Disable"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-info","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Info","originalTitle":"construct:info","route":"/docs/construct/docs-cli#construct-info","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:info","headingPath":["CLI Reference","Information","construct:info"],"snippet":"construct:info Print instance details to chat. Outputs: bound structure ID, enabled state, placed location and dimension, current layer, verifier enabled, structure bounds (min/max). Equivalent to the data shown in the instance menu body.","syntax":"","aliases":["CLI Reference","Information"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-item","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Item","originalTitle":"construct:item","route":"/docs/construct/docs-cli#construct-item","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:item","headingPath":["CLI Reference","Utility","construct:item"],"snippet":"construct:item Give yourself the Construct menu item. Already implemented as a native custom command. Needs to be refactored to fit the new command pipeline.","syntax":"","aliases":["CLI Reference","Utility"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-layer","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Layer","originalTitle":"construct:layer","route":"/docs/construct/docs-cli#construct-layer","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:layer","headingPath":["CLI Reference","Layer Control","construct:layer"],"snippet":"construct:layer Set the active layer of an instance. Argument Description --- --- Name of the instance. Integer layer index. 0 = whole structure (no layer selected). Valid range: 0 to structure.height . Errors if layer is out of bounds. Only meaningful for structures with height 1.","syntax":"","aliases":["CLI Reference","Layer Control"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-list","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct List","originalTitle":"construct:list","route":"/docs/construct/docs-cli#construct-list","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:list","headingPath":["CLI Reference","Instance Management","construct:list"],"snippet":"construct:list List all registered instances and their status. Prints each instance name, its bound structure ID, enabled/disabled state, and placed location (if any). Useful for scripting and quick inspection without opening the GUI.","syntax":"","aliases":["CLI Reference","Instance Management"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-materials-missing","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Materials [missing","originalTitle":"construct:materials [missing","route":"/docs/construct/docs-cli#construct-materials-missing","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:materials [missing","headingPath":["CLI Reference","Information","construct:materials [missing"],"snippet":"construct:materials [missing] Print the material list for an instance. Argument Description --- --- Name of the instance. missing When present, show only materials the player does not have in their inventory (mirrors the \"missing only\" toggle). Can only be used by a player source. Respects the active layer: if a layer is set,…","syntax":"","aliases":["CLI Reference","Information"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-move-x-y-z","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Move [x Y Z","originalTitle":"construct:move [x y z","route":"/docs/construct/docs-cli#construct-move-x-y-z","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:move [x y z","headingPath":["CLI Reference","Placement & Movement","construct:move [x y z"],"snippet":"construct:move [x y z] Reposition a placed instance without toggling its enabled state. Argument Description --- --- Name of a placed instance. Target world coordinates.","syntax":"","aliases":["CLI Reference","Placement & Movement"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-nextlayer","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Nextlayer","originalTitle":"construct:nextlayer","route":"/docs/construct/docs-cli#construct-nextlayer","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:nextlayer","headingPath":["CLI Reference","Layer Control","construct:nextlayer"],"snippet":"construct:nextlayer Step the layer up by one (wraps from max back to 0 ). Mirrors the \"Next layer\" button. Wrapping from max → 0 restores the whole-structure view.","syntax":"","aliases":["CLI Reference","Layer Control"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-option-true-false","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Option True False","originalTitle":"construct:option true false","route":"/docs/construct/docs-cli#construct-option-true-false","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:option true false","headingPath":["CLI Reference","Settings","construct:option true false"],"snippet":"construct:option true false Enable or disable a per-player builder option. Must be run as a player source. Argument Description --- --- One of: easyPlace , fastEasyPlace , materialGrabber . true\\ false Desired state. Runs the option's enable/disable callback (gives or removes the action item). Replaces the toggles in the Buil…","syntax":"","aliases":["CLI Reference","Settings"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-place","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Place","originalTitle":"construct:place","route":"/docs/construct/docs-cli#construct-place","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:place","headingPath":["CLI Reference","Placement & Movement","construct:place"],"snippet":"construct:place Enable and place an instance at a location. Argument Description --- --- Instance to place. World coordinates. Errors if omitted. Supports tilde ( ) notation. Equivalent to the \"Place\" button in the instance menu — enables the instance and calls move() in one step. If the instance already has a location, this…","syntax":"","aliases":["CLI Reference","Placement & Movement"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-prevlayer","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Prevlayer","originalTitle":"construct:prevlayer","route":"/docs/construct/docs-cli#construct-prevlayer","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:prevlayer","headingPath":["CLI Reference","Layer Control","construct:prevlayer"],"snippet":"construct:prevlayer Step the layer down by one (wraps from 0 back to max). Mirrors the \"Previous layer\" button.","syntax":"","aliases":["CLI Reference","Layer Control"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-rename","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Rename","originalTitle":"construct:rename","route":"/docs/construct/docs-cli#construct-rename","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:rename","headingPath":["CLI Reference","Instance Management","construct:rename"],"snippet":"construct:rename Rename an existing instance. Argument Description --- --- Current instance name. Desired new name. Errors if already in use.","syntax":"","aliases":["CLI Reference","Instance Management"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-stats","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Stats","originalTitle":"construct:stats","route":"/docs/construct/docs-cli#construct-stats","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:stats","headingPath":["CLI Reference","Information","construct:stats"],"snippet":"construct:stats Run the structure verifier and print statistics. Triggers a standalone StructureVerifier pass (same as the \"Statistics\" button) and sends the result to chat. Errors if a verifier is already running on this instance.","syntax":"","aliases":["CLI Reference","Information"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-tag","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Tag","originalTitle":"construct:tag","route":"/docs/construct/docs-cli#construct-tag","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:tag","headingPath":["CLI Reference","Utility","construct:tag"],"snippet":"construct:tag Rename the held Construct item to an instance name for quick-open. Errors if the item is not a construct item or if the instance name is not registered. Argument Description --- --- Instance name to embed in the item's nameTag . Using the item in-world will jump straight to that instance's menu. The item-use han…","syntax":"","aliases":["CLI Reference","Utility"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#construct-verifier-true-false","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Construct Verifier True False","originalTitle":"construct:verifier true false","route":"/docs/construct/docs-cli#construct-verifier-true-false","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"construct:verifier true false","headingPath":["CLI Reference","Settings","construct:verifier true false"],"snippet":"construct:verifier true false Toggle the structure verifier for an instance. Argument Description --- --- Name of the instance. true\\ false Whether to run the verifier. Corresponds to the \"validation\" toggle in Settings.","syntax":"","aliases":["CLI Reference","Settings"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#enable-disable","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Disable","originalTitle":"Enable / Disable","route":"/docs/construct/docs-cli#enable-disable","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"Enable / Disable","headingPath":["CLI Reference","Enable / Disable"],"snippet":"Enable / Disable","syntax":"","aliases":["Enable / Disable","CLI Reference"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#settings","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Docs CLI — Settings","originalTitle":"Settings","route":"/docs/construct/docs-cli#settings","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"Settings","headingPath":["CLI Reference","Settings"],"snippet":"Settings","syntax":"","aliases":["Settings","CLI Reference"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#information","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Information","originalTitle":"Information","route":"/docs/construct/docs-cli#information","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"Information","headingPath":["CLI Reference","Information"],"snippet":"Information","syntax":"","aliases":["CLI Reference"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#instance-management","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Instance Management","originalTitle":"Instance Management","route":"/docs/construct/docs-cli#instance-management","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"Instance Management","headingPath":["CLI Reference","Instance Management"],"snippet":"Instance Management","syntax":"","aliases":["CLI Reference"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#layer-control","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Layer Control","originalTitle":"Layer Control","route":"/docs/construct/docs-cli#layer-control","sourceUrl":"https://github.com/ForestOfLight/Construct/blob/28588f8a8f72bb7e5c2d1c571a995ff380814f3a/docs/CLI.md","sourceType":"repository","documentTitle":"CLI Reference","sectionTitle":"Layer Control","headingPath":["CLI Reference","Layer Control"],"snippet":"Layer Control","syntax":"","aliases":["CLI Reference"]},{"id":"construct--repository--docs-cli-md--e9c82a3f68#placement-and-movement","documentId":"construct--repository--docs-cli-md--e9c82a3f68","projectId":"construct","projectTitle":"Construct","repository":"Construct","kind":"command","title":"Placement & Movement","originalTitle":"Placement & Movement","route":"/docs/construct/docs-cli#placement-and-movement","sourceUrl":"https://github.com/ForestOfLight/